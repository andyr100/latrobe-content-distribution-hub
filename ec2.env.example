# Copy to ec2.env and replace every EC2_MACHINE_IP placeholder with the instance's
# current public IPv4 address or public DNS name. Do not commit the resulting ec2.env.
PUBLIC_FRONTEND_BASE_URL=http://EC2_MACHINE_IP
PUBLIC_API_BASE_URL=http://EC2_MACHINE_IP:4080
NEXT_PUBLIC_RSS_AUTO_REFRESH_ENABLED=true
NEXT_PUBLIC_ASSESSMENT_VIDEO_URL=/video/assessment-demo.mp4
